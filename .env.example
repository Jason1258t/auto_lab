# Copy to .env and change the secrets.
DATABASE_URL=postgresql+psycopg://autolab:autolab@localhost:5433/autolab
TEST_DATABASE_URL=postgresql+psycopg://autolab:autolab@localhost:5433/autolab_test

# At least 32 random bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# mongo or file
LOG_STORE=file
MONGO_URL=mongodb://localhost:27017

DATA_DIR=data
PIPELINES_DIR=pipelines
CORS_ORIGINS=["http://localhost:5173"]
